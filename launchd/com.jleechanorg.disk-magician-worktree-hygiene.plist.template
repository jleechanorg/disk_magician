<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.jleechanorg.disk-magician-worktree-hygiene</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/sh</string>
    <string>-c</string>
    <string>"@HOME@/.local/bin/diskm" worktree-slim --clean &amp;&amp; "@HOME@/.local/bin/diskm" worktree-archive</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>HOME</key>
    <string>@HOME@</string>
    <key>DISK_MAGICIAN_TRIGGER</key>
    <string>timer</string>
  </dict>
  <key>StartInterval</key>
  <integer>@WORKTREE_HYGIENE_INTERVAL_SECONDS@</integer>
  <key>StandardOutPath</key>
  <string>@HOME@/Library/Logs/disk-magician-worktree-hygiene.log</string>
  <key>StandardErrorPath</key>
  <string>@HOME@/Library/Logs/disk-magician-worktree-hygiene.log</string>
</dict>
</plist>

<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Cleanup of completed native temp-file leases past the default content floor (rust/src/time_windows.rs). -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.jleechanorg.disk-magician-tmp-scratch</string>
  <key>ProgramArguments</key>
  <array>
    <string>@HOME@/.local/bin/diskm</string>
    <string>scratch-sweep</string>
    <string>--root</string>
    <string>system-tmp</string>
    <string>--clean</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>HOME</key>
    <string>@HOME@</string>
  </dict>
  <key>StartInterval</key>
  <integer>@TEMP_SWEEP_INTERVAL_SECONDS@</integer>
  <key>StandardOutPath</key>
  <string>@HOME@/Library/Logs/disk-magician-tmp-scratch.log</string>
  <key>StandardErrorPath</key>
  <string>@HOME@/Library/Logs/disk-magician-tmp-scratch.log</string>
</dict>
</plist>

<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Persistent read-only 60-second sampler for bead jleechan-tbe3.

  StandardOutPath/StandardErrorPath point at a real log file, not /dev/null
  (fixed 2026-08-01/02, sweeper-health MISS): disk_observer.py's real data
  output already goes to @HOME@/.disk_magician_state/disk_observer.jsonl via
  --output above, independent of stdout/stderr — but routing stdout/stderr to
  /dev/null meant a Python crash/traceback was invisible and the
  sweeper-health watchdog could never confirm liveness from this job. Do NOT
  touch RunAtLoad/KeepAlive/ThrottleInterval below — unrelated and correct.
-->

<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.jleechanorg.disk-magician-observer</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/python3</string>
    <string>@REPO_ROOT@/scripts/disk_observer.py</string>
    <string>watch</string>
    <string>--interval</string>
    <string>60</string>
    <string>--output</string>
    <string>@HOME@/.disk_magician_state/disk_observer.jsonl</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>HOME</key>
    <string>@HOME@</string>
    <key>DOCKER_HOST</key>
    <string>unix://@HOME@/.colima/default/docker.sock</string>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key>
    <false/>
  </dict>
  <key>ThrottleInterval</key>
  <integer>30</integer>
  <key>StandardOutPath</key>
  <string>@HOME@/Library/Logs/disk-magician-observer.log</string>
  <key>StandardErrorPath</key>
  <string>@HOME@/Library/Logs/disk-magician-observer.log</string>
</dict>
</plist>

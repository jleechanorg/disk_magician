<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Periodic sweeper: audit dormant (>=7d) per-task workdirs in ~/.claude/state
  (beads disk_magician-isw, disk_magician-p0v).

  Action:    runs scripts/cleanup_claude_state.sh --dry-run (REPORT ONLY).
             Deliberately dry-run: writes a SAFE / NEEDS-REVIEW / PRESERVE
             ledger to the log without unattended automated deletion.
             Execution (--clean) requires interactive operator approval via
             CLAUDE_STATE_APPROVED=1.
             Enforces 7-day recency floor (worktree_recency.sh content age),
             preserves dirty/unpushed/stashed repos (flagged NEEDS-REVIEW),
             preserves active lsof file handles (fails closed on probe error),
             refuses symlinks escaping the state root, and refuses
             ~/.claude/projects and ~/.codex.

  Schedule:  Every 3 days (StartInterval=259200s).
             RunAtLoad=true ensures execution on login/reboot backstop.

  Template uses @HOME@, @REPO_ROOT@, and @BASH@ placeholders, resolved by
  scripts/install_launchd_sweepers.sh at install time.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.disk-magician.claude-state</string>
  <key>ProgramArguments</key>
  <array>
    <string>@HOME@/.local/bin/diskm</string>
    <string>cleanup-claude-state</string>
    <string>--dry-run</string>
  </array>
  <key>StartInterval</key>
  <integer>259200</integer>
  <key>RunAtLoad</key>
  <true/>
  <key>StandardOutPath</key>
  <string>@HOME@/Library/Logs/disk-magician-claude-state.log</string>
  <key>StandardErrorPath</key>
  <string>@HOME@/Library/Logs/disk-magician-claude-state.log</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>HOME</key>
    <string>@HOME@</string>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
</dict>
</plist>

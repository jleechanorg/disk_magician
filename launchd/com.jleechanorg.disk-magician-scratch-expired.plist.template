<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- On the EXPIRED_SWEEP_INTERVAL cadence (rust/src/time_windows.rs), remove Scratch folders whose newest content is
     past the content floor, regardless of how full Scratch is. -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.jleechanorg.disk-magician-scratch-expired</string>
  <key>ProgramArguments</key>
  <array>
    <string>@HOME@/.local/bin/diskm</string>
    <string>scratch-sweep</string>
    <string>--expired</string>
    <string>--clean</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>DISK_MAGICIAN_TRIGGER</key>
    <string>scratch-expired-timer</string>
    <key>HOME</key>
    <string>@HOME@</string>
  </dict>
  <key>StartInterval</key>
  <integer>@EXPIRED_SWEEP_INTERVAL_SECONDS@</integer>
  <key>StandardOutPath</key>
  <string>@HOME@/Library/Logs/disk-magician-scratch-expired.log</string>
  <key>StandardErrorPath</key>
  <string>@HOME@/Library/Logs/disk-magician-scratch-expired.log</string>
</dict>
</plist>

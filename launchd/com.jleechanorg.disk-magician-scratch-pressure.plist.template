<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Every 20 minutes, check the registered Scratch quota and reclaim
     qualified files in completed native build runs. -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.jleechanorg.disk-magician-scratch-pressure</string>
  <key>ProgramArguments</key>
  <array>
    <string>@HOME@/.local/bin/diskm</string>
    <string>scratch-sweep</string>
    <string>--clean</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>DISK_MAGICIAN_TRIGGER</key>
    <string>scratch-pressure-timer</string>
    <key>HOME</key>
    <string>@HOME@</string>
  </dict>
  <key>StartInterval</key>
  <integer>@SCRATCH_PRESSURE_INTERVAL_SECONDS@</integer>
  <key>StandardOutPath</key>
  <string>@HOME@/Library/Logs/disk-magician-scratch-pressure.log</string>
  <key>StandardErrorPath</key>
  <string>@HOME@/Library/Logs/disk-magician-scratch-pressure.log</string>
</dict>
</plist>

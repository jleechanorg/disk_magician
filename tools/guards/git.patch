@@ -142,7 +191,7 @@
         guard_is_protected "$resolved_allow" && continue
         if [[ "$resolved_target" == "$resolved_allow/"* ]]; then
           guard_decide ALLOW git "worktree add under allowlisted glob '$allow_line' -> '$resolved_allow'"
-          exec "$REAL" "$@"
+          admit_exec worktrees "$resolved_target"
         fi
       done
       continue
@@ -156,7 +205,7 @@
     guard_is_protected "$resolved_allow" && continue
     if [[ "$resolved_target" == "$resolved_allow" || "$resolved_target" == "$resolved_allow/"* ]]; then
       guard_decide ALLOW git "worktree add under allowlisted root '$resolved_allow'"
-      exec "$REAL" "$@"

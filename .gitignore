# Python build artifacts
build/
dist/
*.egg-info/
__pycache__/
*.pyc

# Local development caches
.pytest_cache/
.coverage
htmlcov/

# User configurations
config.json
.claude/

# Machine-local residual-drilldown candidate proposals (never committed;
# human-promoted into config.json — see scripts/residual_drilldown.sh)
config.d/

# Machine-local safety guidelines (schema: safety.local.json.template)
safety.local.json

# Machine-local runtime data (never commit)
# NOTE: .beads/issues.jsonl is intentionally NOT ignored here — it's the
# portable source of truth for bead history (see .beads/.gitignore for the
# actual local-only files: *.db, *.lock, .br_history/, etc). A prior blanket
# `.beads/` rule here silently made this repo's entire bead history
# machine-local-only since inception; fixed 2026-08-03.
storage/
.qdrant-initialized

# /disk-report scratch dir — per-lane drill-down JSON, isolation invariant
# (see skills/disk-report/SKILL.md step 5); never a shared mutable file
docs/.disk-report-scratch/

# Shared venv symlink + linked worktrees (machine-local, never committed —
# see "Shared Venv & Worktree Storage Policy" in CLAUDE.md)
.venv
.worktrees/
uv.lock

[Unit]
Description=Disk Magician Scratch volume
After=local-fs.target

# Mounts the registered Scratch image through its /etc/fstab `user,noauto`
# loop entry, then verifies it is the registered volume.
[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/sh -c 'mountpoint -q "$$1" || mount "$$1"' sh @MOUNTPOINT@
ExecStartPost="%h/.local/bin/diskm" volume verify-mount @MOUNTPOINT@
ExecStop=/bin/umount @MOUNTPOINT@

[Install]
WantedBy=default.target

[Unit]
Description=Disk Magician free-space and Scratch headroom alert
Documentation=https://github.com/jleechanorg/disk-magician
After=local-fs.target

[Service]
Type=oneshot
# Non-secret defaults only; systemd Zero-Environment Unit Principle.
Environment=HOME=@HOME@
Environment=DISK_MAGICIAN_STATE_DIR=@STATE_PATH@
UnsetEnvironment=GITHUB_TOKEN GH_TOKEN
# The alert script exits 1 to mean "an alert fired" — that is the intended
# signal, not a unit failure.
#
# Delivery: the log line alone is not a channel anyone reads (measured
# 2026-11-16: 236 warnings, none delivered). Point the script at a Slack
# incoming webhook and/or a notification email so a fired alert reaches a
# human. Both stay opt-in: with neither set this unit behaves exactly as
# before, logging only. Delivery is best-effort by design, so a webhook or MTA
# failure logs a diagnostic and still leaves the exit signal intact.
# Put the webhook URL in an EnvironmentFile, not here, so the secret is not
# world-readable in the unit:
#   ~/.config/diskm/alert.env
#     DISK_MAGICIAN_ALERT_SLACK_WEBHOOK=https://hooks.slack.com/services/...
#     DISK_MAGICIAN_ALERT_EMAIL_TO=you@example.com
EnvironmentFile=-@HOME@/.config/diskm/alert.env
ExecStart=/usr/bin/bash @ALERT_SCRIPT@
SuccessExitStatus=0 1
# A stalled free-space probe must not wedge the timer.
TimeoutStartSec=300
StandardOutput=append:@STATE_PATH@/disk-usage-alert.log
StandardError=append:@STATE_PATH@/disk-usage-alert.log

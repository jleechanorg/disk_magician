<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Weekly sweeper: delete local APFS (Time Machine) snapshots older than
  1 day, which hold disk space hidden from `du`.

  Schedule:  Sundays at 04:30 local time (Weekday=0, Hour=4, Minute=30)
             — 30 minutes after the worktree-venvs sweep at 04:00.
  Action:    runs scripts/cleanup_apfs_snapshots.sh --clean, which parses
             `tmutil listlocalsnapshots /` and runs
             `tmutil deletelocalsnapshots` for dated snapshots past 1 day.
             Runs as the installing user; the script's dry-run is always safe.

  Template uses @HOME@ placeholders so install scripts can substitute
  $HOME before copying into ~/Library/LaunchAgents/. Do not commit a
  fully-resolved path; keep @HOME@ literal in the repo.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.disk-magician.apfs-snapshots</string>
  <key>ProgramArguments</key>
  <array>
    <!--
      Use bash 5.x explicitly. @BASH@ on macOS is 3.2.57, which
      lacks the regex / array features the script depends on.
      launchd's default environment PATH is /usr/bin:/bin:/usr/sbin:/sbin,
      so "env bash" would also resolve to the wrong binary.
    -->
    <string>@BASH@</string>
    <string>@REPO_ROOT@/scripts/cleanup_apfs_snapshots.sh</string>
    <string>--clean</string>
  </array>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Weekday</key>
    <integer>0</integer>
    <key>Hour</key>
    <integer>4</integer>
    <key>Minute</key>
    <integer>30</integer>
  </dict>
  <key>StandardOutPath</key>
  <string>/tmp/disk-magician-apfs-snapshots.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/disk-magician-apfs-snapshots.log</string>
</dict>
</plist>

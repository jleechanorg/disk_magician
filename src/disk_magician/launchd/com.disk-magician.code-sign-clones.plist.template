<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Periodic sweeper: clean stale macOS app code_sign_clone caches
  (bead disk_magician-disk-fill-prevention-scheduled-cleanup-q6l.3).

  Action:    runs diskm cleanup-code-sign-clones --clean with CODE_SIGN_CLONES_APPROVED=1.
             Enforces 600s minimum extraction age, verifies open file handles via lsof,
             and fails closed on unverified paths.

  Schedule:  Every 12 hours (StartInterval=43200s).
             RunAtLoad=true ensures execution on login/reboot backstop.

  Template uses @HOME@, @REPO_ROOT@, and @BASH@ placeholders, resolved by
  scripts/install_launchd_sweepers.sh at install time.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.disk-magician.code-sign-clones</string>
  <key>ProgramArguments</key>
  <array>
    <string>@HOME@/.local/bin/diskm</string>
    <string>cleanup-code-sign-clones</string>
    <string>--clean</string>
  </array>
  <key>StartInterval</key>
  <integer>43200</integer>
  <key>RunAtLoad</key>
  <true/>
  <key>StandardOutPath</key>
  <string>@HOME@/Library/Logs/disk-magician-code-sign-clones.log</string>
  <key>StandardErrorPath</key>
  <string>@HOME@/Library/Logs/disk-magician-code-sign-clones.log</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>HOME</key>
    <string>@HOME@</string>
    <key>CODE_SIGN_CLONES_APPROVED</key>
    <string>1</string>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
</dict>
</plist>
